# =============================================================
# Enterprise AI Platform - Beispiel-Umgebungskonfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# .env gehört NIE ins Git-Repository (.gitignore blockt sie).
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=enterprise_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Standard: postgres im Docker-Compose-Netzwerk, localhost:5432 für lokale Entwicklung
DATABASE_URL=postgresql+psycopg2://enterprise_ai:change_me_db_password@db:5432/enterprise_ai

# --- Sicherheit ---
# Erzeuge einen geheimen Schlüssel, z.B.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Session-TTL für Chats in Stunden
SESSION_TTL_HOURS=24

# Aufbewahrung von Chat-Daten in Tagen (für den Cleanup-Job)
CHAT_RETENTION_DAYS=30

# Maximale Anzahl an Historien-Nachrichten, die pro Anfrage an Bedrock gesendet werden
MAX_HISTORY_MESSAGES=40

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AWS / Amazon Bedrock ---
# Der Backend-Container soll KEINE Access Keys enthalten.
# Nutze IAM Roles (ECS/EC2) oder die lokale AWS-CLI-Credential-Chain.
AWS_REGION=eu-central-1

# Default-Modell für neue Agents (wird vom Admin pro Agent überschrieben)
BEDROCK_DEFAULT_MODEL_ID=eu.anthropic.claude-3-5-sonnet-20241022-v2:0

# true = lokaler Mock-Modus ohne AWS (für Entwicklung/Tests), false = echte Bedrock-Aufrufe
MOCK_BEDROCK=true

# --- Seed (initialer Admin & Demo-Daten) ---
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_DEMO_USER_EMAIL=fabio@example.com
SEED_DEMO_USER_PASSWORD=change_me_demo_password

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
